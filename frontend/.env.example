# The settings the React app is built with. Vite reads them from these files (all committed, none secret):
#   .env             development (npm run dev, npm test)
#   .env.production  the shared IIS server (npm run build)
# A file named .env.local or .env.production.local (git-ignored) overrides them on your machine only.
# Values are baked into the built JavaScript, so never put a password or key here.

# Where the API and the sign-in server live (the Dixels.Portal.Web backend). May include a path, no trailing slash.
#   development:    https://localhost:44393
#   shared server:  https://192.168.2.164/server
#   Docker:         https://localhost:8443 (set by docker-compose.yml)
# Required: the app refuses to start without it.
VITE_API_URL=https://localhost:44393

# The path the app is served under, with slashes at both ends. Optional; defaults to "/".
#   shared server:  /portal/   (must match frontend/public/web.config and the Portal_App sign-in client's address)
VITE_BASE=/
